{
  "model_name": "bert-base-uncased",
  "decoder_model": "gpt2",
  "checkpoint_dir": "./model_checkpoints",
  
  "training_args": {
    "num_epochs": 3,
    "batch_size": 4,
    "learning_rate": 2e-4,
    "warmup_steps": 100,
    "max_grad_norm": 1.0,
    "gradient_accumulation_steps": 4,
    "weight_decay": 0.01,
    "save_steps": 500,
    "eval_steps": 500,
    "logging_steps": 100
  },
  
  "optimization": {
    "use_lora": true,
    "use_qlora": false,
    "use_mixed_precision": true,
    "distributed_training": false
  },
  
  "lora_config": {
    "r": 8,
    "lora_alpha": 16,
    "target_modules": ["q_proj", "v_proj"],
    "lora_dropout": 0.05,
    "bias": "none"
  },
  
  "logging": {
    "use_wandb": false,
    "wandb_project": "skill-extraction-llm",
    "logging_level": "INFO"
  }
}